# .env.example — Variables sensibles (NUNCA en git). Copia a .env y edita.
# Todas las variables son opcionales: si no existen, se usan los valores de config.yaml.

# Ruta del keypair del comercio (fuera de git).
WALLET_PATH=wallet.json

# RPC público devnet.
RPC_HTTP=https://api.devnet.solana.com
RPC_WS=wss://api.devnet.solana.com
RPC_HTTP_BACKUP=https://api.devnet.solana.com

# Token de prueba para el endpoint manual de dispensado (/api/test/dispense).
# Deja vacío para deshabilitar el endpoint.
TEST_TOKEN=

# Sobrescribe el mint USDC (útil para pruebas con token SPL propio).
# USDC_MINT=
# USDC_DECIMALS=6